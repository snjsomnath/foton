            <chunk name="Object" index="1">
              <items count="2">
                <item name="GUID" type_name="gh_guid" type_code="9">97aa26ef-88ae-4ba6-98a6-ed6ddeca11d1</item>
                <item name="Name" type_name="gh_string" type_code="10">Foton Annual Daylight</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="15">
                    <item name="Description" type_name="gh_string" type_code="10">Run an annual daylight study on the GPU and get Daylight Autonomy, Continuous Daylight Autonomy, Useful Daylight Illuminance and Spatial Daylight Autonomy for every sensor grid in a Honeybee model.

Results are written in the same layout as Honeybee's Annual Daylight recipe, so connect results to HB Annual Daylight Metrics or HB Annual Results to Data to use them with other Ladybug Tools components. Pair a metric with the grid meshes in LB Spatial Heatmap to see it on the model.</item>
                    <item name="GraftStandardOutputLines" type_name="gh_bool" type_code="1">true</item>
                    <item name="IconOverride" type_name="gh_drawing_bitmap" type_code="37">
                      <bitmap length="1419"></bitmap>
                    </item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">f87f5583-254f-47c9-9305-f8d1fb1ebca3</item>
                    <item name="MarshGuids" type_name="gh_bool" type_code="1">false</item>
                    <item name="MarshInputs" type_name="gh_bool" type_code="1">false</item>
                    <item name="MarshOutputs" type_name="gh_bool" type_code="1">false</item>
                    <item name="Name" type_name="gh_string" type_code="10">Foton Annual Daylight</item>
                    <item name="NickName" type_name="gh_string" type_code="10">FotonAnnual</item>
                    <item name="ScriptComponentVersion" type_name="gh_int32" type_code="3">3</item>
                    <item name="Tooltip" type_name="gh_string" type_code="10">Run an annual daylight study on the GPU and get Daylight Autonomy, Continuous Daylight Autonomy, Useful Daylight Illuminance and Spatial Daylight Autonomy for every sensor grid in a Honeybee model.

Results are written in the same layout as Honeybee's Annual Daylight recipe, so connect results to HB Annual Daylight Metrics or HB Annual Results to Data to use them with other Ladybug Tools components. Pair a metric with the grid meshes in LB Spatial Heatmap to see it on the model.</item>
