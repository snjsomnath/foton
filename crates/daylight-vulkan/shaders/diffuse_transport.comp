uint sobol_uint(uint index, uint dimension) {
    uint gray = index ^ (index >> 1), value = 0;
    uint offset = (dimension % 16u) * 32u;
    for (uint bit=0; bit<32; ++bit) {
        if ((gray & (1u << bit)) != 0) value ^= sobol_directions[offset + bit];
    }
    return value;
}
uint owen_scramble(uint value, uint seed) {
    value = bitfieldReverse(value);
    value ^= value * 0x3d20adea; value += seed;
    value *= (seed >> 16) | 1u;
    value ^= value * 0x05526c56; value ^= value * 0x53a22864;
    return bitfieldReverse(value);
}
float sequence_value(uint sensor_id, uint sample_index, uint bounce, uint dimension) {
    uint seed = mix32(uniforms.scene_seed_low ^ uniforms.scene_seed_high
        ^ rotate_left(sensor_id,7) ^ rotate_left(bounce,13) ^ dimension*0x9e3779b9);
    return (float(owen_scramble(sobol_uint(sample_index, dimension), seed)) + 0.5)
        * (1.0 / 4294967296.0);
}
vec3 cosine_direction(vec3 normal, uint sensor_id, uint sample_index, uint bounce) {
    float first = sequence_value(sensor_id,sample_index,bounce,bounce*2u);
    float second = sequence_value(sensor_id,sample_index,bounce,bounce*2u+1u);
    float radius = sqrt(first), azimuth = 6.28318530718 * second;
    vec3 local = vec3(radius*cos(azimuth), radius*sin(azimuth), sqrt(1.0-first));
    vec3 helper = abs(normal.z)<0.999 ? vec3(0,0,1) : vec3(1,0,0);
    vec3 tangent = normalize(cross(helper,normal)), bitangent = cross(normal,tangent);
    return normalize(tangent*local.x + bitangent*local.y + normal*local.z);
}
uint ring_count(uint ring) {
    const uint counts[7] = uint[7](30,30,24,24,18,12,6);
    return counts[min(ring,6)];
}
uint radiance_patch(vec3 direction) {
    if (direction.z < 0.0) return 0;
    uint multiplier = uniforms.patch_count == 146 ? 1 : 2;
    uint regular_rows = 7 * multiplier;
    float increment = 1.57079632679 / (float(regular_rows)+0.5);
    uint row = uint(floor(asin(clamp(direction.z,-1.0,1.0))/increment));
    if (row >= regular_rows) return uniforms.patch_count-1;
    uint parent = uint(floor((float(row)+0.5)/float(multiplier)));
    uint row_count = ring_count(parent)*multiplier, offset=1;
    for (uint prior=0; prior<row; ++prior)
        offset += ring_count(uint(floor((float(prior)+0.5)/float(multiplier))))*multiplier;
    float azimuth = atan(direction.x,direction.y);
    if (azimuth<0.0) azimuth += 6.28318530718;
    float step = 6.28318530718/float(row_count);
    uint index = uint(floor((azimuth+0.5*step)/step));
    return offset + (index>=row_count ? 0 : index);
}
void accumulate(uint destination, vec3 value) {
    uvec3 ticks = uvec3(round(max(value,0.0)*uniforms.accumulator_scale));
    atomicAdd(indirect_values.values[destination],ticks.x);
    atomicAdd(indirect_values.values[destination+1],ticks.y);
    atomicAdd(indirect_values.values[destination+2],ticks.z);
}
void main() {
    uint local_sample=gl_GlobalInvocationID.x, sensor_index=gl_GlobalInvocationID.y;
    if (local_sample>=uniforms.sample_count || sensor_index>=uniforms.sensor_count) return;
    Sensor sensor=sensors.values[sensor_index];
    uint sample_index=uniforms.sample_offset+local_sample;
    vec3 origin=sensor.position+sensor.normal*1e-4;
    vec3 direction=cosine_direction(normalize(sensor.normal),sensor.sensor_id,sample_index,0);
    vec3 throughput=vec3(1);
    uint diffuse_bounces=0, transparent=0;
    uint maximum=uniforms.maximum_bounces+uniforms.max_transparent+1;
    for (uint path=0; path<maximum; ++path) {
        rayQueryEXT query;
        rayQueryInitializeEXT(query,scene_as,gl_RayFlagsOpaqueEXT,uniforms.active_mask,origin,1e-6,direction,1e30);
        while(rayQueryProceedEXT(query)) {}
        if(rayQueryGetIntersectionTypeEXT(query,true)==gl_RayQueryCommittedIntersectionNoneEXT) {
            if(diffuse_bounces>0) {
                uint patch_index=radiance_patch(direction);
                accumulate((sensor_index*uniforms.patch_count+patch_index)*3,
                    throughput*(3.14159265359/float(uniforms.sample_count)));
            }
            break;
        }
        uint instance_index=rayQueryGetIntersectionInstanceCustomIndexEXT(query,true);
        uint triangle=metadata.values[instance_index].material_offset
            + rayQueryGetIntersectionPrimitiveIndexEXT(query,true);
        Material material=materials.values[triangle_materials.values[triangle]];
        vec3 normal=hit_normal(instance_index,triangle,direction);
        float distance=rayQueryGetIntersectionTEXT(query,true);
        if(material.kind==1) {
            if(transparent>=uniforms.max_transparent) break;
            float incidence=abs(dot(direction,normal));
            vec3 transmission=thin_glass_transmission(material.internal_transmissivity_rgb,incidence);
            vec3 reflection=thin_glass_reflection(material.internal_transmissivity_rgb,incidence);
            float transmission_energy=color_intensity(transmission);
            float reflection_energy=color_intensity(reflection);
            float total_energy=transmission_energy+reflection_energy;
            if(total_energy<=1e-8) break;
            float reflection_probability=reflection_energy/total_energy;
            float branch_sample=sequence_value(
                sensor.sensor_id,sample_index,diffuse_bounces,12u+transparent);
            if(branch_sample<reflection_probability) {
                throughput*=reflection/reflection_probability;
                origin+=direction*distance+normal*1e-4;
                direction=reflect(direction,normal);
            } else {
                float transmission_probability=1.0-reflection_probability;
                if(transmission_probability<=1e-8) break;
                throughput*=transmission/transmission_probability;
                origin+=direction*(distance+1e-4);
            }
            if(all(lessThanEqual(throughput,vec3(1e-6)))) break;
            ++transparent; continue;
        }
        if(diffuse_bounces>=uniforms.maximum_bounces) break;
        throughput*=material.diffuse_rgb;
        if(all(lessThanEqual(throughput,vec3(1e-6)))) break;
        origin+=direction*distance+normal*1e-4;
        ++diffuse_bounces;
        direction=cosine_direction(normal,sensor.sensor_id,sample_index,diffuse_bounces);
    }
}
